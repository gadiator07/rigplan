{
  "name": "rigplan",
  "productName": "RigPlan",
  "version": "1.0.0",
  "description": "Rig- und Lichtplanung mit 2D-Plan, 3D-Ansicht, DMX-Patch und MVR-Export für grandMA3",
  "author": "RigPlan",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "renderer": "node tools/build-renderer.js",
    "icon": "node tools/make-icon.js",
    "start": "npm run renderer && electron .",
    "dist": "npm run renderer && npm run icon && electron-builder --win nsis",
    "test:app": "node tools/test-app.js"
  },
  "build": {
    "appId": "de.rigplan.app",
    "productName": "RigPlan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RigPlan",
      "artifactName": "RigPlan-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "playwright-core": "^1.65.0",
    "three": "^0.128.0"
  }
}
